[Unit]
Description=AXIOM v3 — captura y núcleo
After=network.target postgresql.service

[Service]
Type=simple
User=migue
WorkingDirectory=/home/migue/apps/axiom-v3
EnvironmentFile=/home/migue/apps/axiom-v3/.env
ExecStart=/home/migue/apps/axiom-v3/venv/bin/python -m backend.app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
