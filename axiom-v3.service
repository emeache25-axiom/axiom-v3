[Unit]
Description=AXIOM v3 — API, captura y núcleo
After=network.target postgresql.service

[Service]
Type=simple
User=migue
WorkingDirectory=/home/migue/apps/axiom-v3
EnvironmentFile=/home/migue/apps/axiom-v3/.env
ExecStart=/home/migue/apps/axiom-v3/venv/bin/uvicorn backend.servidor:app --host 0.0.0.0 --port 8003
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
